# Copy this file to .env and fill in your values

# Google Sheets Spreadsheet ID (from the URL: /spreadsheets/d/SPREADSHEET_ID/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account credentials (paste the entire JSON as a single line, or use a file path)
# Option A: Inline JSON (escape quotes, remove newlines)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Option B: Path to the service account key file (comment out GOOGLE_SERVICE_ACCOUNT_JSON above)
# GOOGLE_KEY_FILE=./service-account-key.json

# Port to run the server on (default: 3000)
PORT=3000

# Optional: A secret token to protect the manager link-generation endpoint
# MANAGER_TOKEN=some_secret_token
